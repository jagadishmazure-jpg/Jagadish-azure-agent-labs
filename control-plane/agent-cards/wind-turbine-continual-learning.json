{
  "capabilities": {
    "extensions": [
      {
        "description": "Owner, deployment zone, side effects, deny list, eval gate, reviewer",
        "params": {
          "agent_id": "wind-turbine-continual-learning",
          "data_zone": "us",
          "denied_tools": [
            "*fit_detector*",
            "*registry*",
            "*shutdown_fleet*",
            "promote_*",
            "retrain_*"
          ],
          "deployed": false,
          "eval_gate": [
            "heldout_recall >= 0.9",
            "heldout_fpr <= 0.1",
            "diagnosis_accuracy >= 0.85",
            "bad_candidates_rejected >= 1.0",
            "registry_unchanged_by_agents >= 1.0",
            "lesson_learned_from_feedback >= 1.0",
            "overbroad_lesson_rejected >= 1.0",
            "lesson_gain >= 0.1",
            "gating_precision >= 1.0",
            "safer_decision_after_learning >= 1.0"
          ],
          "human_review": "turbine technician",
          "model_deployment": "turbine-diagnosis",
          "owner": "fleet-reliability",
          "side_effect_class": "episode memory + candidate lesson write after HITL",
          "stage": "lab"
        },
        "uri": "urn:azure-agent-labs:control-plane:v1"
      }
    ],
    "streaming": false
  },
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "description": "Static maintenance (Isolation Forest + pattern rules), episodic memory, context-gated lessons, evaluation, learning signals and candidate-lesson extraction for wind turbines; technician-confirmed episodes become memory. Detector and lesson promotion are separate eval-gated pipelines, not agent skills.",
  "name": "Turbine Diagnostics with Continual Learning",
  "provider": {
    "organization": "Azure agent labs (demo)",
    "url": "https://github.com/jagadishmazure-jpg"
  },
  "skills": [
    {
      "description": "Detect, retrieve, diagnose and recommend for one turbine.",
      "id": "check_turbine",
      "inputModes": [
        "application/json"
      ],
      "name": "Check turbine window",
      "outputModes": [
        "application/json"
      ],
      "tags": [
        "telemetry",
        "anomaly"
      ]
    },
    {
      "description": "Confirm, correct or reject; evaluates the outcome, emits a learning signal and a candidate lesson, and writes the episode to memory.",
      "id": "record_technician_decision",
      "inputModes": [
        "application/json"
      ],
      "name": "Record technician decision",
      "outputModes": [
        "application/json"
      ],
      "tags": [
        "hitl"
      ]
    }
  ],
  "supportedInterfaces": [
    {
