# Every lab runs offline with deterministic stand-ins by default. No values here are secrets.
LAB_MODE=offline            # offline | azure  (azure selects the adapter stubs, which raise until wired up)
LAB_TRACE_CONSOLE=0         # 1 = print OpenTelemetry spans to the console

# Only read when LAB_MODE=azure. Endpoints and names, never keys: auth is managed identity.
FOUNDRY_PROJECT_ENDPOINT=   # https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_DATA_ZONE=us        # data zone the model deployments must live in (us | eu)
AZURE_CLIENT_ID=            # user-assigned managed identity client id
APPLICATIONINSIGHTS_CONNECTION_STRING=
